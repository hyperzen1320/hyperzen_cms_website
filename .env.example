# ---------------------------------------------------------------------------
# Database (PostgreSQL — works with Supabase, Neon, RDS or self-hosted)
# ---------------------------------------------------------------------------
# Production example:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Supabase / Neon pooled connections also need a direct URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Bootstrap admin account, used by `npm run admin:create`
ADMIN_EMAIL="admin@hyperzen.in"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_NAME="Hyperzen Admin"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (SMTP). These are fallbacks — the same values can be managed from
# /admin/settings/email, which takes precedence when configured there.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="Hyperzen Innovation <no-reply@hyperzen.in>"
EMAIL_NOTIFICATION="hello@hyperzen.in"

# ---------------------------------------------------------------------------
# Media storage
#   local  -> writes to /public/uploads (default for local development)
#   db     -> stores binaries in PostgreSQL (works on serverless/Vercel)
# ---------------------------------------------------------------------------
MEDIA_STORAGE="local"
MAX_UPLOAD_MB="8"

# ---------------------------------------------------------------------------
# SMS (optional) — lets password-reset codes go out by text as well as email.
# Leave SMS_PROVIDER empty and the portal simply offers email.
# ---------------------------------------------------------------------------
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
